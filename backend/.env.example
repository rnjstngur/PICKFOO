# 팀원별 개인 설정 예시. 이 파일은 공유해도 되며 .env에 자신의 값으로 복사해야 합니다.
DB_NAME=pickfoo_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
# For a deployed domain use DJANGO_DEBUG=false, DJANGO_ALLOWED_HOSTS=your.domain
# DATABASE_URL=postgresql://... (optional alternative to DB_* settings)
# DATABASE_SSL_REQUIRE=true
# DJANGO_TRUST_PROXY_HTTPS=true
# PICKFOO_MEDIA_STORAGE=s3
# AWS_STORAGE_BUCKET_NAME=...
# AWS_S3_REGION_NAME=...
# AWS_S3_ENDPOINT_URL=...  (only for S3-compatible providers)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
